# Copie para .deploy-env no servidor (ou .env local em dev). NUNCA commitar segredos.

NODE_ENV=production
PORT=3030
APP_TZ=America/Bahia

# Banco próprio do checklist
DATABASE_URL=postgres://checklist:SENHA@127.0.0.1:5432/checklist
# Banco do plantoes (mesmo usuário, acesso somente-leitura via GRANT SELECT)
PLANTOES_DATABASE_URL=postgres://checklist:SENHA@127.0.0.1:5432/plantoes

# Bot @samu_checklists_bot
TELEGRAM_BOT_TOKEN=
# Chat IDs (privados) que recebem avisos e digests, separados por vírgula
TELEGRAM_ADMIN_IDS=
# Código para promover novos admins via /admin <código>
ADMIN_SETUP_CODE=
# Horários locais dos digests automáticos
DIGEST_SLOTS=11:00,13:00
# Exigir a chave do dia (entregue pelo bot) para registrar checklist (true/false)
CHECKLIST_KEY_REQUIRED=true

# "polling" em produção; "disabled" desativa o bot (canary/dev sem token)
BOT_MODE=polling
PUBLIC_URL=https://checklist.mnrs.com.br
